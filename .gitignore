# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
tests/.pytest_tmp/
build/
dist/
.venv/
venv/

# Measured artefacts are regenerated, not tracked. Keep the small ones that
# document a result, ignore the large scratch output.
benchmarks/out/_perf_scratch/
benchmarks/out/*.tmp

# The corpus is generated by benchmarks/rr_m0/corpus_generator.py and is
# reproducible from it, so the binary files are not tracked. The ground truth and
# manifest are small and are the evidence, so they are kept.
benchmarks/corpus/files/
benchmarks/corpus/images/
benchmarks/corpus/anomalies/

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
