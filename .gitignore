# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
tests/.pytest_tmp/
build/
dist/
.venv/
venv/

# Measured artefacts are regenerated, not tracked. Keep the small ones that
# document a result, ignore the large scratch output.
benchmarks/out/_perf_scratch/
benchmarks/out/*.tmp

# Runtime state. `var/` is the default RR_DATA_DIR and holds the SQLite database,
# the imported originals, rendered page images and exports; none of it is source
# and all of it is reproducible by importing a file again.
var/

# Secrets. The translation key is read from the environment by the server and is
# never sent to the browser, so a committed .env would put it in the repository
# for no benefit.
.env
.env.*
!.env.example

# Verification scripts write their settings-isolated workspaces here.
var_*/

# The corpus is generated by benchmarks/rr_m0/corpus_generator.py and is
# reproducible from it, so the binary files are not tracked. The ground truth and
# manifest are small and are the evidence, so they are kept.
benchmarks/corpus/files/
benchmarks/corpus/images/
benchmarks/corpus/anomalies/

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
