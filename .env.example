# Configuration for the research reader.  Copy to `.env` and fill in what you need.
#
# You probably do not need this file for translation any more.  The reader has a settings panel
# (the "翻译设置" button) where the base URL, the model id and the API key are stored in the local
# database, and both processes pick a change up on the next job without being restarted.
#
# This file is still the right place for two things: pinning a value for one command
# (`RR_TRANSLATION_MODEL=... python -m rr_worker`), and setting anything the panel does not
# expose.  An environment variable always wins over a stored setting, and the panel names the
# fields it is currently overriding rather than leaving you to work out why a saved value had no
# effect.  Set RR_ENV_FILE to load a different path.
#
# Reading, anchoring, annotations, the outline and the bilingual export all work with nothing
# set here.  Only translation needs a provider.

# ---------------------------------------------------------------------------
# Translation provider
# ---------------------------------------------------------------------------
# Prefer the settings panel.  If you set the key here instead, it stays on the server: it is
# never sent to the browser and is reported to the UI only as a boolean, so a page cannot read
# it.  Either way the key only ever travels *to* the service; no endpoint returns it.  Without a
# key the reader works and translation reports `translation_not_configured` instead of
# pretending.
# RR_TRANSLATION_API_KEY=

# Endpoint.  The default targets Ollama's OpenAI-compatible cloud API.  That value is marked
# NOT VERIFIED in the code: this environment cannot resolve ollama.com, so the first real call is
# the thing that confirms it.  Set this explicitly once you know your endpoint.
# RR_TRANSLATION_BASE_URL=https://ollama.com/v1

# Model id, passed through to the provider unchanged.
# RR_TRANSLATION_MODEL=

# A name shown in the UI and recorded on every translation row, so a translation can be traced to
# the provider that produced it.  Defaults to `ollama`.
# RR_TRANSLATION_NAME=ollama

# Per-request timeout in seconds.
# RR_TRANSLATION_TIMEOUT=60

# How many requests may be in flight at once.
# RR_TRANSLATION_CONCURRENCY=4

# Attempts per unit before it is recorded as failed.  A failure is per unit, and the rest of the
# job continues.
# RR_TRANSLATION_MAX_ATTEMPTS=3

# Sampling temperature.
# RR_TRANSLATION_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Storage and limits
# ---------------------------------------------------------------------------
# Where the database, imported originals, rendered page images and exports live.
# RR_DATA_DIR=var

# Upload and parse limits.  Exceeding one is a refusal with a reason, not a crash.
# RR_MAX_FILE_MB=200
# RR_MAX_PAGES=2000
# RR_MAX_UNCOMPRESSED_MB=400
# RR_MAX_ARCHIVE_RATIO=200

# How long a worker's claim on a job stays valid without a heartbeat before another worker may
# take it over.
# RR_LEASE_SECONDS=120

# Refuse a translation plan larger than this rather than queueing an unbounded job.
# RR_MAX_TRANSLATION_UNITS=5000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# The server binds loopback only and is not reachable from the network.
# RR_PORT=8765
# RR_ENV_FILE=.env
