# This file becomes .env.docker on first launch. Never put real keys in this template.
RR_COMPOSE_PROJECT=research-reader
RR_HTTP_PORT=8765
# Optional same-host Zotero Desktop (Windows/macOS Docker Desktop).
# No Zotero port is published. Native reader startup defaults to 127.0.0.1.
RR_ZOTERO_HOST=host.docker.internal
# Optional registry/build mirrors. Defaults are pinned in compose.yaml/Dockerfile.
# RR_PYTHON_IMAGE=python:3.11-slim-bookworm
# RR_GROBID_IMAGE=grobid/grobid:0.9.1-crf
# RR_APT_MIRROR=https://repo.huaweicloud.com/debian
# Configure translation through the reader's settings panel after startup.
# The server stores configuration inside the private data volume.
